<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="254.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TournamentViewController">
   <Label fx:id="currentMatchupLabel" layoutX="100.0" layoutY="38.0" text="Current Matchup">
      <font>
         <Font name="System Bold" size="18.0" />
      </font>
   </Label>
   <ComboBox fx:id="selectWinnerComboBox" layoutX="100.0" layoutY="187.0" prefWidth="150.0" promptText="Select Winner" />
   <Label fx:id="currentMatchupView" layoutX="40.0" layoutY="75.0" maxWidth="1.7976931348623157E308" prefWidth="270.0" text="Current Matchup" textAlignment="CENTER" wrapText="true">
      <font>
         <Font size="36.0" />
      </font>
   </Label>
   <Button fx:id="enterWinner" layoutX="149.0" layoutY="228.0" mnemonicParsing="false" onAction="#onActionSelectWinner" text="Submit" />
</AnchorPane>
